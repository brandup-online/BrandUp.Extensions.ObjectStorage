<Project>

	<!-- Common to every project in the solution -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
		<!-- Imported before the SDK props, which add 1701;1702 only to an empty NoWarn; nested props append to it -->
		<NoWarn Condition="'$(NoWarn)' == ''">1701;1702</NoWarn>
	</PropertyGroup>

</Project>
