<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>BrandUp.Extensions.ObjectStorage</Title>
    <Description>S3-compatible object storage implementation using AWS SDK. Supports Yandex Cloud Object Storage, Amazon S3, MinIO, and other S3-compatible providers. Includes bucket management, versioning, lifecycle rules and ACL.</Description>
    <PackageTags>s3;objectstorage;awssdk;yandexcloud;amazons3;minio;cloud;storage</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrandUp.Extensions.ObjectStorage.Abstraction\BrandUp.Extensions.ObjectStorage.Abstraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BrandUp.Extensions.ObjectStorage.Tests" />
  </ItemGroup>

</Project>
