<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BrandUp.Extensions.ObjectStorage</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Title>BrandUp.Extensions.ObjectStorage.Abstraction</Title>
    <Description>Abstractions for S3-compatible object storage: IObjectStorageContext, IObjectStorageClient, IObjectBucket, BucketSettings and JSON extension methods. No dependency on AWS SDK.</Description>
    <PackageTags>s3;objectstorage;abstractions;cloud;storage;yandexcloud</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Storage-context model building is shared infrastructure of the implementation packages. -->
    <InternalsVisibleTo Include="BrandUp.Extensions.ObjectStorage" />
    <InternalsVisibleTo Include="BrandUp.Extensions.ObjectStorage.Testing" />
    <InternalsVisibleTo Include="BrandUp.Extensions.ObjectStorage.Abstraction.Tests" />
    <InternalsVisibleTo Include="BrandUp.Extensions.ObjectStorage.Tests" />
    <InternalsVisibleTo Include="BrandUp.Extensions.ObjectStorage.Testing.Tests" />
  </ItemGroup>

</Project>
